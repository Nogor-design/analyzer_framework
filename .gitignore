.venv/
.venv*/
.pytest_cache/
.ta_artifacts/
__pycache__/
*.py[cod]
*.pyd
*.so
*.dll
*.egg-info/
.idea/
.claude/

outputs*/
None/
$null

# Codex / claude test process logs left around the repo root.
.codex_*.log
.codex_*.out.log
.codex_*.err.log

# Editor scratch files (atomic-save temp files).
*.tmp.*

# Per-machine fixture path overrides (point at large local market data
# files outside the repo). Test discovery loads these if present.
*.local.json

# Ad-hoc per-invocation output / runs directories. The committed
# `outputs/` plural is excluded by `outputs*/` above; this catches the
# singular forms that the CLI / discovery / strategy_lifecycle scripts
# create as scratch.
/output/
/runs/

# Local-only databases — runtime state, not source.
*.duckdb
agent_state.db

# Board-report scratch — ad-hoc Node tooling + generated Word docs.
node_modules/
package.json
package-lock.json
*.docx
build_report.js
create_board_report.js
generate_board_report.js

# Synthetic market data + generators — transient test fixtures, not source.
*_synthetic.csv
synthetic_data/
synthetic_exports/
synthetic_test_data/
gen_synthetic.py
generate_synthetic_data.py

# Ad-hoc scratch dir + editor backups.
scratch/
*.bak

.codex_tmp/

# Stray unexpanded-env-var dir from a test run
%TEMP%/

# Generated weekly report output (large PNGs) — do not track in git
ExampleWeeklyReport/

# Research-ledger runtime database. Rebuilt from research_ledger/migrations/,
# which are the source of truth -- the .sqlite file is derived state.
data/research_ledger.sqlite

# Trading-competition submission tree (codex_nq_v2). A self-contained side
# project rather than ta_foundation source: 6.7MB of generated positions /
# trades CSVs, parquet, pickles and .pyc alongside its own scripts. If it needs
# version control it wants its own repo, not this one.
comp-rules/
