.venv/
.venv*/
.pytest_cache/
.ta_artifacts/
__pycache__/
*.py[cod]
*.pyd
*.so
*.dll
*.egg-info/
.idea/
.claude/

outputs*/
None/
$null

# Codex / claude test process logs left around the repo root.
.codex_*.log
.codex_*.out.log
.codex_*.err.log

# Editor scratch files (atomic-save temp files).
*.tmp.*

# Per-machine fixture path overrides (point at large local market data
# files outside the repo). Test discovery loads these if present.
*.local.json

# Ad-hoc per-invocation output / runs directories. The committed
# `outputs/` plural is excluded by `outputs*/` above; this catches the
# singular forms that the CLI / discovery / strategy_lifecycle scripts
# create as scratch.
/output/
/runs/

# Local-only databases — runtime state, not source.
*.duckdb
agent_state.db

# Board-report scratch — ad-hoc Node tooling + generated Word docs.
node_modules/
package.json
package-lock.json
*.docx
build_report.js
create_board_report.js
generate_board_report.js

# Synthetic market data + generators — transient test fixtures, not source.
*_synthetic.csv
synthetic_data/
synthetic_exports/
synthetic_test_data/
gen_synthetic.py
generate_synthetic_data.py

# Ad-hoc scratch dir + editor backups.
scratch/
*.bak
