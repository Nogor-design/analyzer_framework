<?xml version="1.0" encoding="utf-8"?>
<StrategyTemplate>
  <StrategyType>NinjaTrader.NinjaScript.Strategies.StrategyDiscoveryFilter</StrategyType>
  <Strategy>
    <StrategyDiscoveryFilter xmlns:xsd="http://www.w3.org/2001/XMLSchema" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
      <IsVisible>true</IsVisible>
      <calculate2>OnBarClose</calculate2>
      <AreLinesConfigurable>true</AreLinesConfigurable>
      <ArePlotsConfigurable>true</ArePlotsConfigurable>
      <BarsPeriodSerializable>
        <BarsPeriodTypeSerialize>4</BarsPeriodTypeSerialize>
        <BaseBarsPeriodType>Minute</BaseBarsPeriodType>
        <BaseBarsPeriodValue>1</BaseBarsPeriodValue>
        <VolumetricDeltaType>BidAsk</VolumetricDeltaType>
        <MarketDataType>Last</MarketDataType>
        <PointAndFigurePriceType>Close</PointAndFigurePriceType>
        <ReversalType>Tick</ReversalType>
        <Value>1</Value>
        <Value2>1</Value2>
      </BarsPeriodSerializable>
      <BarsToLoad>0</BarsToLoad>
      <Calculate>OnBarClose</Calculate>
      <Displacement>0</Displacement>
      <DisplayInDataBox>true</DisplayInDataBox>
      <From>2026-01-05T00:00:00</From>
      <IsAutoScale>true</IsAutoScale>
      <Lines />
      <MaximumBarsLookBack>TwoHundredFiftySix</MaximumBarsLookBack>
      <Name>StrategyDiscoveryFilter</Name>
      <Panel>-1</Panel>
      <Plots />
      <ScaleJustification>Right</ScaleJustification>
      <ShowTransparentPlotsInDataBox>false</ShowTransparentPlotsInDataBox>
      <To>2026-03-26T00:00:00</To>
      <IsDataSeriesRequired>true</IsDataSeriesRequired>
      <IsOverlay>true</IsOverlay>
      <SelectedValueSeries>0</SelectedValueSeries>
      <Gtd>1800-01-01T00:00:00</Gtd>
      <Template />
      <TimeInForce>Gtc</TimeInForce>
      <BacktestCommissionTemplate />
      <BarsPeriodParameter>
        <Increment>1</Increment>
        <Max xsi:type="xsd:int">0</Max>
        <Min xsi:type="xsd:int">0</Min>
        <Name />
        <ParameterTypeSerializable>System.Int32, mscorlib, Version=4.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089</ParameterTypeSerializable>
        <ValueSerializable>0</ValueSerializable>
      </BarsPeriodParameter>
      <BarsRequiredToTrade>50</BarsRequiredToTrade>
      <Category>Backtest</Category>
      <ConnectionLossHandling>Recalculate</ConnectionLossHandling>
      <DaysToLoad>5</DaysToLoad>
      <DefaultQuantity>1</DefaultQuantity>
      <DisconnectDelaySeconds>10</DisconnectDelaySeconds>
      <EntriesPerDirection>1</EntriesPerDirection>
      <EntryHandling>AllEntries</EntryHandling>
      <ExitOnSessionCloseSeconds>30</ExitOnSessionCloseSeconds>
      <IncludeCommission>false</IncludeCommission>
      <InstrumentOrInstrumentList>NQ 06-26</InstrumentOrInstrumentList>
      <IsAggregated>false</IsAggregated>
      <IsExitOnSessionCloseStrategy>true</IsExitOnSessionCloseStrategy>
      <IsFillLimitOnTouch>false</IsFillLimitOnTouch>
      <IsOptimizeDataSeries>false</IsOptimizeDataSeries>
      <IsStableSession>true</IsStableSession>
      <IsTickReplay>false</IsTickReplay>
      <IsTradingHoursBreakLineVisible>true</IsTradingHoursBreakLineVisible>
      <IsWaitUntilFlat>false</IsWaitUntilFlat>
      <NumberRestartAttempts>4</NumberRestartAttempts>
      <OptimizationPeriod>10</OptimizationPeriod>
      <OrderFillResolution>Standard</OrderFillResolution>
      <OrderFillResolutionType>Minute</OrderFillResolutionType>
      <OrderFillResolutionValue>1</OrderFillResolutionValue>
      <RestartsWithinMinutes>5</RestartsWithinMinutes>
      <SetOrderQuantity>Strategy</SetOrderQuantity>
      <Slippage>0</Slippage>
      <StartBehavior>WaitUntilFlat</StartBehavior>
      <StopTargetHandling>PerEntryExecution</StopTargetHandling>
      <SupportsOptimizationGraph>true</SupportsOptimizationGraph>
      <TestPeriod>28</TestPeriod>
      <TradingHoursSerializable />
      <DrawOnPricePanel>false</DrawOnPricePanel>
      <ZOrder>-2147483648</ZOrder>

      <!-- ═══════════════════════════════════════════════════════════════════
           A: REGIME FILTER
           Source: Strategy Discovery -> Market Regime + Feature Importance
           RegimeMode options: Any | TrendingOnly | RangingOnly | TrendingUp
                               TrendingDown | NoHighVol | LowVolOnly | HighVolOnly
           Start with TrendingOnly if ADX is a top feature.
           Start with NoHighVol if high_vol_expansion shows negative PF.
      ═══════════════════════════════════════════════════════════════════ -->
      <RegimeMode>TrendingOnly</RegimeMode>
      <AdxPeriod>14</AdxPeriod>
      <!-- Set AdxThreshold to the value from report entry rules (adx >= XX) -->
      <AdxThreshold>25</AdxThreshold>
      <RegimeEmaPeriod>50</RegimeEmaPeriod>
      <AtrPeriod>14</AtrPeriod>
      <AtrLookbackBars>100</AtrLookbackBars>
      <VolLowPercentile>0.3</VolLowPercentile>
      <VolHighPercentile>0.7</VolHighPercentile>

      <!-- ═══════════════════════════════════════════════════════════════════
           B: SESSION FILTER
           Source: Strategy Discovery -> Trade Evaluation (session breakdown)
           Enable only the sessions where the report shows positive PF.
           Most futures strategies: AllowRTH=true, AllowONH=false.
      ═══════════════════════════════════════════════════════════════════ -->
      <AllowRTH>true</AllowRTH>
      <AllowONH>false</AllowONH>
      <AllowETH>false</AllowETH>
      <!-- RTH = 8:30 AM to 3:00 PM Central Time (NQ/ES futures) -->
      <RthStartH>8</RthStartH>
      <RthStartM>30</RthStartM>
      <RthEndH>15</RthEndH>
      <RthEndM>0</RthEndM>
      <!-- ETH = 7:00 AM to 8:29 AM (pre-RTH extended) -->
      <EthStartH>7</EthStartH>
      <EthStartM>0</EthStartM>
      <EthEndH>8</EthEndH>
      <EthEndM>29</EthEndM>

      <!-- ═══════════════════════════════════════════════════════════════════
           C: DIRECTION FILTER
           Source: Strategy Discovery -> Trade Evaluation (direction breakdown)
           If Long PF > 1.3 but Short PF < 1.0, set AllowShort=false.
      ═══════════════════════════════════════════════════════════════════ -->
      <AllowLong>true</AllowLong>
      <AllowShort>true</AllowShort>
      <!-- UseTrendAlignment: in trending_up only take longs; in trending_down only shorts -->
      <UseTrendAlignment>true</UseTrendAlignment>

      <!-- ═══════════════════════════════════════════════════════════════════
           D: ENTRY SIGNAL
           EMA crossover is the base signal. Tune periods to match your strategy.
      ═══════════════════════════════════════════════════════════════════ -->
      <EntryEmaPeriod>5</EntryEmaPeriod>
      <SlowEmaPeriod>200</SlowEmaPeriod>
      <RequireEmaConfirmation>true</RequireEmaConfirmation>
      <RequireMinAtrMultiple>0</RequireMinAtrMultiple>

      <!-- ═══════════════════════════════════════════════════════════════════
           E: EXIT POLICY
           Source: Strategy Discovery -> Exit Policy Sweep + MAE/MFE Profile
           ExitPolicy options: FixedRR | AtrTrail | Chandelier | Giveback | FixedStop | BreakEvenOnly
           StopTicks  = p75 MAE from MAE/MFE Profile (protects 75% of winners)
           TargetTicks = p50 MFE from MAE/MFE Profile (captures median natural move)
           Example for NQ: Stop=60 ticks ($300), Target=90 ticks ($450)
      ═══════════════════════════════════════════════════════════════════ -->
      <ExitPolicy>FixedRR</ExitPolicy>
      <StopTicks>60</StopTicks>
      <TargetTicks>90</TargetTicks>
      <AtrTrailMultiple>2</AtrTrailMultiple>
      <ChandelierLookback>20</ChandelierLookback>
      <!-- GivebackPct: 0.4 = exit when 40% of peak open profit disappears -->
      <GivebackPct>0.4</GivebackPct>
      <BreakEvenTriggerTicks>30</BreakEvenTriggerTicks>
      <BreakEvenPlusTicks>4</BreakEvenPlusTicks>

      <!-- ═══════════════════════════════════════════════════════════════════
           F: DAILY RISK LIMITS
           Source: Strategy Discovery -> Drawdown Analysis + Position Sizing
           MaxDailyLossUsd: set to approx 1x your average winning trade
           MaxDailyTrades:  set to max_consecutive_losses + 2
      ═══════════════════════════════════════════════════════════════════ -->
      <MaxDailyLossUsd>500</MaxDailyLossUsd>
      <MaxDailyProfitUsd>2000</MaxDailyProfitUsd>
      <MaxDailyTrades>6</MaxDailyTrades>

      <!-- ═══════════════════════════════════════════════════════════════════
           G: DEBUG
      ═══════════════════════════════════════════════════════════════════ -->
      <EnableDebugPrint>false</EnableDebugPrint>
      <Contracts>1</Contracts>
    </StrategyDiscoveryFilter>
  </Strategy>
</StrategyTemplate>
